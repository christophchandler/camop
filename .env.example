# Backblaze B2 (S3-compatible). Use a bucket dedicated to CamOp and a key limited to it.
B2_ACCOUNT_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=camop-recordings
B2_BUCKET_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Producer dashboard password (required for anything you deploy)
DASHBOARD_PASSWORD=choose-a-long-password

# Signs guest links. Optional: falls back to B2_APPLICATION_KEY so links survive restarts.
# If you set it, keep it stable; changing it invalidates links already sent.
SESSION_SECRET=

PORT=3000
NODE_ENV=production
SESSION_TTL_HOURS=72

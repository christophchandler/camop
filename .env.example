# Backblaze B2 Storage
B2_ACCOUNT_ID=your_backblaze_account_id
B2_APPLICATION_KEY=your_backblaze_app_key
B2_BUCKET_NAME=your-bucket-name
B2_BUCKET_ENDPOINT=https://s3.us-west-002.backblazeb2.com

# Server
PORT=3000
NODE_ENV=production

# CORS (comma-separated origins, leave empty to allow all)
ALLOWED_ORIGINS=https://camop.foundercast.co

# Session limits
MAX_SESSIONS=100
SESSION_TTL_HOURS=24
